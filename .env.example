# TeleDrive desktop app — environment variables.
# Copy to `.env` and uncomment/edit values as needed.
# Variables prefixed with `VITE_` are exposed to the client bundle by Vite.

# Base URL of the teledrive-backend service.
# Dev:   http://localhost:3000 (matches the backend's default port)
# Prod:  https://teledrive-backend.onrender.com (or your deployed URL)
VITE_API_BASE_URL=http://localhost:3000